# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL — used in email confirmation links.
# Without this, links default to the request origin (e.g. http://localhost:3000).
# Set to your production URL for deployed environments.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Strava
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
# Random string used to verify Strava webhook subscription ownership
STRAVA_WEBHOOK_VERIFY_TOKEN=your-random-secret-string

# Anthropic (for AI features)
ANTHROPIC_API_KEY=sk-ant-...
