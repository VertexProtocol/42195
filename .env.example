# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL — used in email confirmation links and OAuth redirects.
# Without this, links default to the request origin (e.g. http://localhost:3000).
# Set to your production URL for deployed environments.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Strava OAuth App ────────────────────────────────────────────────────────
# Create your app at https://www.strava.com/settings/api
# Set the Authorization Callback Domain to your app domain.
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret

# Random string used to verify Strava webhook subscription ownership.
# Generate with: openssl rand -hex 32
STRAVA_WEBHOOK_VERIFY_TOKEN=your-random-secret-string

# Subscription id returned when the webhook subscription was created.
# Set it to reject forged webhook deliveries; leave blank to skip the check.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# Signing in with Strava may create an account for an athlete who has never
# been here. Registration is otherwise closed at the Supabase project level,
# and the admin call that creates a user is NOT subject to that setting — so
# this is the gate for that path, and it is off unless it says "true".
# Athletes who already have an account can sign in either way.
STRAVA_SIGNUP_ENABLED=false

# There is no bootstrap path any more. Every account authorises its own Strava
# athlete through the OAuth redirect at /api/auth/strava — a shared refresh
# token would bind someone else's athlete to a new account.

# Shared secret for the scheduled job at /api/cron/resume-sync, which finishes
# history syncs that stopped on Strava's rate limit. Vercel Cron sends it as
# "Authorization: Bearer <this>". The route refuses every request while this is
# unset — it moves other accounts' data, so an open version of it is worse than
# a cron that never runs.
# Generate with: openssl rand -hex 32
#
# The schedule is not in vercel.json: a Hobby account rejects the deployment
# outright for any cron that runs more than daily, and daily is not worth much
# against a rate limit window that reopens every 15 minutes. It is scheduled
# from Postgres instead — see scripts/032_schedule_resume_sync.sql, which also
# wants this value stored in Supabase Vault.
CRON_SECRET=

# Anthropic (for AI features)
ANTHROPIC_API_KEY=sk-ant-...
