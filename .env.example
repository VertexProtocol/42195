# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL — used in email confirmation links and OAuth redirects.
# Without this, links default to the request origin (e.g. http://localhost:3000).
# Set to your production URL for deployed environments.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Strava OAuth App ────────────────────────────────────────────────────────
# Create your app at https://www.strava.com/settings/api
# Set the Authorization Callback Domain to your app domain.
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret

# Random string used to verify Strava webhook subscription ownership.
# Generate with: openssl rand -hex 32
STRAVA_WEBHOOK_VERIFY_TOKEN=your-random-secret-string

# ─── Bootstrap Tokens (optional, one-time setup) ─────────────────────────────
# If you already have a valid Strava refresh token, you can use the bootstrap
# endpoint (POST /api/auth/strava/setup) to seed strava_tokens directly without
# going through the full OAuth redirect flow.
#
# Steps:
#  1. Paste your refresh token below.
#  2. Sign in to the app, then POST /api/auth/strava/setup.
#  3. Once successful, remove these two variables.
#
# Leave blank to use the standard OAuth flow instead.
STRAVA_BOOTSTRAP_ACCESS_TOKEN=
STRAVA_BOOTSTRAP_REFRESH_TOKEN=

# Anthropic (for AI features)
ANTHROPIC_API_KEY=sk-ant-...
